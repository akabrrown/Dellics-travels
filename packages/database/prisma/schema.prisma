generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MembershipTier {
  EXPLORER
  VOYAGER
  ELITE
}

enum BookingType {
  FLIGHT
  HOTEL
  PACKAGE
  CAR
  ACTIVITY
}

enum BookingStatus {
  HELD
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PriceAlertStatus {
  ACTIVE
  TRIGGERED
  CANCELLED
}

enum ESIMOrderStatus {
  PENDING
  PROVISIONED
  ACTIVE
  EXPIRED
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  phone           String?
  role            Role           @default(USER)
  membership_tier MembershipTier @default(EXPLORER)

  trips         Trip[]
  memberships   Membership[]
  rewards       RewardsLedger[]
  price_alerts  PriceAlert[]
  fare_freezes  FareFreeze[]
  reviews       Review[]
  esim_orders   ESIMOrder[]

  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
}

model Trip {
  id         String    @id @default(uuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id])
  title      String
  start_date DateTime
  end_date   DateTime

  bookings   Booking[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
}

model Booking {
  id           String        @id @default(uuid())
  trip_id      String
  trip         Trip          @relation(fields: [trip_id], references: [id])
  type         BookingType
  status       BookingStatus @default(HELD)
  supplier_ref String?

  payments     Payment[]
  rewards      RewardsLedger[]
  reviews      Review[]

  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
}

model Payment {
  id                       String        @id @default(uuid())
  booking_id               String
  booking                  Booking       @relation(fields: [booking_id], references: [id])
  stripe_payment_intent_id String        @unique
  amount                   Decimal       @db.Decimal(10, 2)
  currency                 String
  status                   PaymentStatus @default(PENDING)

  created_at               DateTime      @default(now())
  updated_at               DateTime      @updatedAt
}

model Membership {
  id                     String         @id @default(uuid())
  user_id                String
  user                   User           @relation(fields: [user_id], references: [id])
  tier                   MembershipTier
  stripe_subscription_id String?        @unique
  renews_at              DateTime?

  created_at             DateTime       @default(now())
  updated_at             DateTime       @updatedAt
}

model RewardsLedger {
  id           String   @id @default(uuid())
  user_id      String
  user         User     @relation(fields: [user_id], references: [id])
  points_delta Int
  reason       String
  booking_id   String?
  booking      Booking? @relation(fields: [booking_id], references: [id])

  created_at   DateTime @default(now())
}

model PriceAlert {
  id           String           @id @default(uuid())
  user_id      String
  user         User             @relation(fields: [user_id], references: [id])
  origin       String
  destination  String
  target_price Decimal          @db.Decimal(10, 2)
  status       PriceAlertStatus @default(ACTIVE)

  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt
}

model FareHistory {
  id                String   @id @default(uuid())
  route_or_property String
  price             Decimal  @db.Decimal(10, 2)
  captured_at       DateTime @default(now())
}

model FareFreeze {
  id                       String   @id @default(uuid())
  user_id                  String
  user                     User     @relation(fields: [user_id], references: [id])
  fare_ref                 String
  frozen_price             Decimal  @db.Decimal(10, 2)
  stripe_payment_intent_id String   @unique
  expires_at               DateTime

  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt
}

model Review {
  id          String   @id @default(uuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id])
  booking_id  String
  booking     Booking  @relation(fields: [booking_id], references: [id])
  rating      Int
  sub_scores  Json?
  text        String?
  photos      String[]

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model ESIMPlan {
  id                String      @id @default(uuid())
  country_or_region String
  data_gb           Decimal     @db.Decimal(10, 2)
  validity_days     Int
  price             Decimal     @db.Decimal(10, 2)
  airalo_package_id String      @unique

  orders            ESIMOrder[]

  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt
}

model ESIMOrder {
  id                       String          @id @default(uuid())
  user_id                  String
  user                     User            @relation(fields: [user_id], references: [id])
  esim_plan_id             String
  esim_plan                ESIMPlan        @relation(fields: [esim_plan_id], references: [id])
  stripe_payment_intent_id String          @unique
  qr_code_url              String?
  iccid                    String?
  status                   ESIMOrderStatus @default(PENDING)

  created_at               DateTime        @default(now())
  updated_at               DateTime        @updatedAt
}

enum InquiryKind {
  CONTACT
  INQUIRY
}

model Inquiry {
  id         String      @id @default(uuid())
  kind       InquiryKind
  name       String
  email      String
  phone      String?
  message    String
  payload    Json?

  created_at DateTime    @default(now())
}
