# Dellics Travels - Backend Server Environment Variables Template (.env.example)

PORT=3000
NODE_ENV=development

# Database & Supabase
DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Travel Aggregator API Keys
DUFFEL_API_KEY=duffel_test_key
RATEHAWK_KEY_ID=your-key-id
RATEHAWK_API_ID=your-api-id
RATEHAWK_API_KEY=your-api-key
RATEHAWK_BASE_URL=https://api-sandbox.ratehawk.com
AMADEUS_API_KEY=your-amadeus-api-key
AMADEUS_API_SECRET=your-amadeus-secret

# Payments (Paystack - Mobile Money & Cards)
PAYSTACK_SECRET_KEY=sk_live_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_public_key
PAYSTACK_BASE_URL=https://api.paystack.co

# FX-Port (Multi-Currency & Fares)
FXPORT_API_KEY=fxp_test_your_key
FXPORT_WEBHOOK_SECRET=whsec_your_secret


# Airalo Partner eSIM API
AIRALO_CLIENT_ID=your-airalo-client-id
AIRALO_CLIENT_SECRET=your-airalo-client-secret
AIRALO_ENVIRONMENT=sandbox
