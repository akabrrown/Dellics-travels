.env
.env.*
*.env
*.env.*
!.env.example
!.env.*.example

# Secret keys, certs, tokens & service accounts
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
id_rsa*
id_ed25519*
service-account*.json
credentials*.json
token*.json
*secret*
!*secret*.ts
!*secret*.js
!*secret*.md

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles
.next/
out/
build/
dist/
.expo/
.expo-shared/
*.tsbuildinfo

# Turbo & Monorepo Caches
.turbo/

